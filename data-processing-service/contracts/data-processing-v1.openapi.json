    "/api/v1/metrics/history": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Get Processed Metric History",
        "description": "Histórico de Monitoring: zona explícita, segundos enteros, máximo 24h, sin imputación.",
        "operationId": "get_processed_metric_history_api_v1_metrics_history_get",
        "parameters": [
          {
            "name": "metric",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "node.cpu.utilization",
                "node.memory.used",
                "node.network.receive",
                "node.network.transmit",
                "node.filesystem.used"
              ],
              "type": "string",
              "title": "Metric"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "End"
            }
          },
          {
            "name": "resourceType",
            "in": "query",
            "required": false,
            "schema": {
              "const": "node",
              "type": "string",
              "default": "node",
              "title": "Resourcetype"
            }
          },
          {
            "name": "cluster",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cluster"
            }
          },
          {
            "name": "resourceId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Resourceid"
            }
          },
          {
            "name": "stepSeconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 3600,
              "minimum": 15,
              "default": 15,
              "title": "Stepseconds"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
